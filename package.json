{
  "name": "pokedex-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:fe": "vite --host 127.0.0.1",
    "dev:full": "concurrently -k -n API,FE \"npm run dev\" \"npm run dev:fe\"",
    "build:fe": "vite build",
    "cli": "tsx src/cli.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit",
    "collect:data": "tsx src/scripts/collect-pokemon-data.ts",
    "populate_db": "tsx src/scripts/populate-vector-database.ts",
    "collect:populate-db": "tsx src/scripts/collect-and-populate-vector-database.ts",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.41.0",
    "@langchain/core": "^1.3.7",
    "@langchain/openai": "^1.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^8.3.8"
  }
}
